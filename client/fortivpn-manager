def dot_icon(color, size=64, ring=False):
    pixmap = QPixmap(size, size)
    pixmap.fill(Qt.GlobalColor.transparent)
    painter = QPainter(pixmap)
    painter.setRenderHint(QPainter.RenderHint.Antialiasing)
    painter.setPen(Qt.PenStyle.NoPen)
    if ring:
        painter.setBrush(QColor(color).lighter(160))
        painter.drawEllipse(0, 0, size, size)
    painter.setBrush(QColor(color))
    margin = size // 6 if ring else size // 8
    painter.drawEllipse(margin, margin, size - 2 * margin, size - 2 * margin)
    painter.end()
    return QIcon(pixmap)


def run_privileged(program, *args, stdin_data=None, timeout=120):
    """Run a fortivpn helper as root through pkexec; return (code, output)."""
    try:
        result = subprocess.run(
            ["pkexec", f"{SBIN}/{program}", *args], input=stdin_data,
            capture_output=True, text=True, timeout=timeout, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return 1, str(error)
    output = (result.stdout + result.stderr).strip()
    if result.returncode in (126, 127) and not output:
        output = "Authorization was cancelled or denied."
    return result.returncode, output


class ConnectionDialog(QDialog):
    """Single form with every field of a connection."""

    FIELDS = [
        ("name", "Connection name", "Any label to recognize this connection."),
        ("gateway", "FortiGate address", "IP address or hostname of the VPN gateway."),
        ("local_id", "Local ID", "Exactly as given by your administrator; it selects the tunnel."),
        ("user", "Username", "Your VPN username."),
        ("password", "Password", "Your personal VPN password."),
        ("psk", "Pre-shared key (PSK)", "Key of the VPN tunnel. It is not your password."),
        ("ranges", "Remote networks", "Comma-separated networks routed through the VPN."),
    ]

    def __init__(self, parent, values=None):
        super().__init__(parent)
        self.new = values is None
        self.setWindowTitle("New connection" if self.new else "Edit connection")
        self.setMinimumWidth(600)
        self.inputs = {}
        self.errors = {}

        form = QFormLayout()
        form.setFieldGrowthPolicy(QFormLayout.FieldGrowthPolicy.ExpandingFieldsGrow)
        form.setVerticalSpacing(4)
        for key, label, help_text in self.FIELDS:
            edit = QLineEdit()
            if key in ("psk", "password"):
                edit.setEchoMode(QLineEdit.EchoMode.Password)
                if not self.new:
                    edit.setPlaceholderText("Leave empty to keep the current value")
            elif values:
                edit.setText(values.get(key, ""))
            if key == "ranges" and self.new:
                edit.setPlaceholderText("198.51.100.0/24, 203.0.113.0/24")
            self.inputs[key] = edit
            help_label = QLabel(help_text)
            help_label.setWordWrap(True)
            help_label.setEnabled(False)
            error_label = QLabel()
            error_label.setStyleSheet("color: #c0392b;")
            error_label.setWordWrap(True)
            error_label.hide()
            self.errors[key] = error_label
            column = QVBoxLayout()
            column.setSpacing(2)
            column.addWidget(edit)
            column.addWidget(help_label)
            column.addWidget(error_label)
            form.addRow(label, column)

        show_secrets = QCheckBox("Show password and PSK")
        show_secrets.toggled.connect(self.toggle_secrets)
        form.addRow("", show_secrets)

        buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Save | QDialogButtonBox.StandardButton.Cancel)
        buttons.accepted.connect(self.try_accept)
        buttons.rejected.connect(self.reject)

        layout = QVBoxLayout(self)
        layout.addLayout(form)
        layout.addSpacing(8)
        layout.addWidget(buttons)
        self.inputs["name"].setFocus()

    def toggle_secrets(self, visible):
        mode = QLineEdit.EchoMode.Normal if visible else QLineEdit.EchoMode.Password
        self.inputs["psk"].setEchoMode(mode)
        self.inputs["password"].setEchoMode(mode)

    def values(self):
        result = {key: edit.text().strip() for key, edit in self.inputs.items()}
        # Secrets are used verbatim: surrounding spaces may be significant.
        result["psk"] = self.inputs["psk"].text()
        result["password"] = self.inputs["password"].text()
        return result

    def try_accept(self):
        for label in self.errors.values():
            label.hide()
        values = self.values()
        problems = validate_form(values, self.new)
        if values["psk"] and values["psk"] == values["password"]:
            problems.append(("psk", "The PSK must differ from your password."))
        for key, message in problems:
            self.errors[key].setText(message)
            self.errors[key].show()
        self.adjustSize()
        if problems:
            self.inputs[problems[0][0]].setFocus()
            return
        self.accept()


class OtpDialog(QDialog):
    def __init__(self, parent, profile_name):
        super().__init__(parent)
        self.setWindowTitle(f"{APP_NAME} — OTP code")
        self.setMinimumWidth(380)
        title = QLabel(f"<b>{profile_name}</b>")
        text = QLabel("Enter the code received by email:")
        self.code = QLineEdit()
        self.code.setMaxLength(8)
        self.code.setPlaceholderText("4 to 8 digits")
        font = self.code.font()
        font.setPointSizeF(font.pointSizeF() * 1.4)
        self.code.setFont(font)
        self.error = QLabel("The code must contain 4 to 8 digits.")
        self.error.setStyleSheet("color: #c0392b;")
        self.error.hide()
        buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        buttons.accepted.connect(self.try_accept)
        buttons.rejected.connect(self.reject)
        layout = QVBoxLayout(self)
        for widget in (title, text, self.code, self.error, buttons):
            layout.addWidget(widget)
        self.setWindowFlag(Qt.WindowType.WindowStaysOnTopHint)

    def try_accept(self):
        if OTP_RE.match(self.code.text().strip()):
            self.accept()
        else:
            self.error.show()


class Connector(QWidget):
    """Runs fortivpn-up and answers the OTP request while it runs."""

    finished = pyqtSignal(bool, str)

    def __init__(self, parent):
        super().__init__(parent)
        self.hide()
        self.process = None
        self.profile = None
        self.output = ""
        self.last_nonce = None
        self.agent_stopped = False
        self.otp_timer = QTimer(self)
        self.otp_timer.setInterval(300)
        self.otp_timer.timeout.connect(self.check_otp_request)

    def running(self):
        return self.process is not None

    def start(self, profile):
        self.profile = profile
        self.output = ""
        self.last_nonce = self.read_nonce()  # ignore a request left from before
        # The background agent would show a second OTP prompt.
        if subprocess.run(["systemctl", "--user", "is-active", "--quiet", OTP_AGENT],
                          check=False).returncode == 0:
            subprocess.run(["systemctl", "--user", "stop", OTP_AGENT], check=False)
            self.agent_stopped = True
        self.process = QProcess(self)
        self.process.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.process.readyReadStandardOutput.connect(self.collect)
        self.process.finished.connect(self.done)
        self.process.errorOccurred.connect(self.failed_to_start)
        self.process.start("pkexec", [f"{SBIN}/fortivpn-up", profile.slug])
        self.otp_timer.start()

    def collect(self):
        self.output += bytes(self.process.readAllStandardOutput()).decode(errors="replace")

    @staticmethod
    def read_nonce():
        try:
            with open(OTP_REQUEST, encoding="ascii") as stream:
                match = REQUEST_RE.match(stream.read())
                return match.group(1) if match else None
        except OSError:
            return None

    def check_otp_request(self):
        nonce = self.read_nonce()
        if not nonce or nonce == self.last_nonce:
            return
        self.last_nonce = nonce
        dialog = OtpDialog(self.parentWidget(), self.profile.name)
        dialog.show()
        dialog.raise_()
        dialog.activateWindow()
        if dialog.exec() != QDialog.DialogCode.Accepted:
            self.output += "\nOTP entry cancelled.\n"
            return
        code = dialog.code.text().strip()
        try:
            descriptor = os.open(OTP_PIPE, os.O_WRONLY | os.O_NONBLOCK)
            try:
                os.write(descriptor, f"{nonce} {code}\n".encode("ascii"))
            finally:
                os.close(descriptor)
        except OSError as error:
            reason = "the request expired" if error.errno == errno.ENXIO else str(error)
            self.output += f"\nCould not deliver the OTP: {reason}.\n"

    def failed_to_start(self, error):
        if error == QProcess.ProcessError.FailedToStart:
            self.output += "pkexec could not be started."
            self.done(1, None)

    def done(self, code, _status=None):
        if self.process is None:
            return
        self.otp_timer.stop()
        self.collect()
        self.process.deleteLater()
        self.process = None
        if self.agent_stopped:
            subprocess.run(["systemctl", "--user", "start", OTP_AGENT], check=False)
            self.agent_stopped = False
        self.finished.emit(code == 0, self.output.strip())


