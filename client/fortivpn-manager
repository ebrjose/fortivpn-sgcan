    def build_tray(self):
        self.tray = None
        if not QSystemTrayIcon.isSystemTrayAvailable():
            return
        self.tray = QSystemTrayIcon(self)
        self.tray_menu = QMenu()
        self.tray.setContextMenu(self.tray_menu)
        self.tray.activated.connect(self.tray_activated)
        self.tray.show()

    def update_tray(self):
        if not self.tray:
            return
        state = self.display_state()
        self.tray.setIcon(dot_icon(STATE_COLORS[state], ring=state == "connected"))
        profile = self.profile_by_slug(self.status.slug or self.pending_slug)
        name = profile.name if profile else ""
        tooltip = f"{APP_NAME}: {STATE_LABELS[state]}" + (f" — {name}" if name and state != "disconnected" else "")
        if state == "connected" and self.status.virtual_ip:
            tooltip += f"\n{self.status.virtual_ip}"
        self.tray.setToolTip(tooltip)

        menu = self.tray_menu
        menu.clear()
        menu.addAction("Open", self.show_window)
        menu.addSeparator()
        busy = self.connector.running()
        if state == "disconnected":
            connect_menu = menu.addMenu("Connect")
            connect_menu.setEnabled(bool(self.profiles) and not busy)
            for item in self.profiles:
                connect_menu.addAction(item.name, lambda p=item: self.connect_profile(p))
        else:
            action = menu.addAction(f"Disconnect {name}".strip(), self.disconnect)
            action.setEnabled(state == "connected" or busy)
        menu.addSeparator()
        menu.addAction("Quit", self.quit)

    # ---- data ---------------------------------------------------------
    def profile_by_slug(self, slug):
        return next((item for item in self.profiles if item.slug == slug), None)

    def selected_profile(self):
        row = self.list.currentRow()
        return self.profiles[row] if 0 <= row < len(self.profiles) else None

    def reload_profiles(self, select_slug=None):
        current = select_slug or (self.selected_profile().slug if self.selected_profile() else None)
        self.profiles = load_profiles()
        self.list.blockSignals(True)
        self.list.clear()
        for item in self.profiles:
            self.list.addItem(QListWidgetItem(item.name))
        row = next((i for i, item in enumerate(self.profiles) if item.slug == current), 0)
        if self.profiles:
            self.list.setCurrentRow(row)
        self.list.blockSignals(False)
        self.right.setCurrentIndex(1 if self.profiles else 0)
        self.refresh_details()

    def display_state(self):
        if self.connector.running():
            return "connecting"
        return self.status.state

    def poll_status(self):
        if self.status_process is not None:
            return
        if not shutil.which("swanctl"):
            self.status_error = "swanctl is not installed."
            return
        self.status_process = QProcess(self)
        self.status_process.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.status_process.finished.connect(self.status_ready)
        self.status_process.start("swanctl", ["--list-sas"])

    def status_ready(self, code, _status):
        output = bytes(self.status_process.readAllStandardOutput()).decode(errors="replace")
        self.status_process.deleteLater()
        self.status_process = None
        previous = self.display_state()
        if code == 0:
            self.status = parse_list_sas(output)
            self.status_error = ""
        else:
            self.status = TunnelStatus()
            self.status_error = ("The connection status is unavailable. Log out and back in, "
                                 "or reinstall fortivpn-sgcan for this user.")
        current = self.display_state()
        if previous != current:
            self.notify_change(previous, current)
        self.refresh_details()

    def notify_change(self, previous, current):
        if not self.tray or previous == "connecting" and current == "connecting":
            return
        profile = self.profile_by_slug(self.status.slug or self.pending_slug)
        name = profile.name if profile else "VPN"
        if current == "connected":
            self.tray.showMessage(APP_NAME, f"{name} connected ({self.status.virtual_ip}).",
                                  QSystemTrayIcon.MessageIcon.Information, 4000)
        elif current == "disconnected" and previous == "connected":
            self.tray.showMessage(APP_NAME, f"{name} disconnected.",
                                  QSystemTrayIcon.MessageIcon.Information, 4000)

    # ---- view ---------------------------------------------------------
    def refresh_details(self):
        state = self.display_state()
        active_slug = self.status.slug if self.status.state != "disconnected" else ""
        if self.connector.running():
            active_slug = self.pending_slug
        for row, item in enumerate(self.profiles):
            item_state = state if item.slug == active_slug else "disconnected"
            self.list.item(row).setIcon(dot_icon(STATE_COLORS[item_state]))

        profile = self.selected_profile()
        if profile:
            selected_state = state if profile.slug == active_slug else "disconnected"
            self.title.setText(profile.name)
            self.state_icon.setPixmap(dot_icon(STATE_COLORS[selected_state]).pixmap(14, 14))
            self.state_label.setText(STATE_LABELS[selected_state])
            values = {"gateway": profile.gateway, "local_id": profile.local_id,
                      "ranges": profile.ranges.replace(",", ", ")}
            if selected_state == "connected":
                values.update(
                    vip=self.status.virtual_ip or "—",
                    duration=format_duration(self.status.established_seconds),
                    bytes_in=format_bytes(self.status.bytes_in),
                    bytes_out=format_bytes(self.status.bytes_out))
            for key, label in self.detail_labels.items():
                label.setText(values.get(key, "—"))
            other_active = active_slug and active_slug != profile.slug
            if selected_state == "disconnected":
                self.action_button.setText("Connect")
                self.action_button.setEnabled(not self.connector.running())
                self.action_button.setToolTip(
                    "Connecting will disconnect the other active connection." if other_active else "")
            elif selected_state == "connecting":
                self.action_button.setText("Cancel")
                self.action_button.setEnabled(True)
            else:
                self.action_button.setText("Disconnect")
                self.action_button.setEnabled(True)
            busy = profile.slug == active_slug
            self.edit_button.setEnabled(not busy)
            self.delete_button.setEnabled(not busy)
        else:
            self.edit_button.setEnabled(False)
            self.delete_button.setEnabled(False)
        if self.status_error:
            self.show_message(self.status_error, error=True)
        self.update_tray()

    def show_message(self, text, error=False):
        self.message.setText(text)
        self.message.setStyleSheet("color: #c0392b;" if error else "")
        self.message.setVisible(bool(text))

    def set_log(self, text):
        self.log.setPlainText(text)
        self.log_toggle.setVisible(bool(text))
        if not text:
            self.log.hide()
            self.log_toggle.setText("Show details")

    def toggle_log(self):
        visible = not self.log.isVisible()
        self.log.setVisible(visible)
        self.log_toggle.setText("Hide details" if visible else "Show details")

    # ---- actions ------------------------------------------------------
    def toggle_connection(self):
        profile = self.selected_profile()
        if not profile:
            return
        active = self.status.slug if self.status.state != "disconnected" else ""
        if self.connector.running() or active == profile.slug:
            self.disconnect()
        else:
            self.connect_profile(profile)

    def connect_profile(self, profile):
        if self.connector.running():
            return
        self.pending_slug = profile.slug
        self.show_message(f"Connecting {profile.name}. A window will ask for the OTP when the "
                          "FortiGate sends it.")
        self.set_log("")
        self.connector.start(profile)
        self.refresh_details()

    def connect_finished(self, ok, output):
        profile = self.profile_by_slug(self.pending_slug)
        name = profile.name if profile else "VPN"
        self.pending_slug = ""
        if ok:
            self.show_message("")
            self.set_log(output)
        else:
            hint = ""
            if "MAC mismatched" in output:
                hint = " Check the PSK and the Local ID."
            elif "peer not responding" in output:
                hint = " The FortiGate did not answer; wait a few minutes and retry."
            elif "OTP" in output and "cancel" in output.lower():
                hint = " The OTP was not entered."
            self.show_message(f"Could not connect {name}.{hint}", error=True)
            self.set_log(output)
            if self.tray:
                self.tray.showMessage(APP_NAME, f"Could not connect {name}.",
                                      QSystemTrayIcon.MessageIcon.Warning, 5000)
        self.poll_status()
        self.refresh_details()

    def disconnect(self):
        code, output = run_privileged("fortivpn-down", timeout=30)
        if code != 0:
            self.show_message(f"Could not disconnect: {output}", error=True)
        else:
            self.show_message("")
        self.poll_status()

    def new_profile(self):
        dialog = ConnectionDialog(self)
        if dialog.exec() == QDialog.DialogCode.Accepted:
            self.save_profile("new", dialog.values())

    def edit_profile(self):
        profile = self.selected_profile()
        if not profile:
            return
        code, output = run_privileged("fortivpn-profile", "show", profile.slug, timeout=60)
        if code != 0:
            self.show_message(f"Could not read the connection: {output}", error=True)
            return
        lines = (output.splitlines() + [""] * 5)[:5]
        values = dict(zip(("name", "gateway", "local_id", "user", "ranges"), lines))
        dialog = ConnectionDialog(self, values)
        if dialog.exec() == QDialog.DialogCode.Accepted:
            self.save_profile(profile.slug, dialog.values())

    def save_profile(self, slug, values):
        data = "".join(f"{values[key]}\n" for key in
                       ("name", "gateway", "local_id", "user", "ranges", "psk", "password"))
        code, output = run_privileged("fortivpn-profile", "save", slug, "--stdin",
                                      stdin_data=data, timeout=60)
        values.clear()
        if code != 0:
            QMessageBox.warning(self, APP_NAME, f"Could not save the connection:\n{output}")
            return
        saved_slug = output.splitlines()[-1].strip() if output else slug
        self.reload_profiles(select_slug=saved_slug)
        self.show_message("Connection saved.")

    def delete_profile(self):
        profile = self.selected_profile()
        if not profile:
            return
        answer = QMessageBox.question(
            self, APP_NAME, f"Delete '{profile.name}' and its stored credentials?")
        if answer != QMessageBox.StandardButton.Yes:
            return
        code, output = run_privileged("fortivpn-profile", "delete", profile.slug, timeout=60)
        if code != 0:
            QMessageBox.warning(self, APP_NAME, f"Could not delete the connection:\n{output}")
        self.reload_profiles()

    # ---- window and tray ----------------------------------------------
    def tray_activated(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            if self.isVisible() and not self.isMinimized():
                self.hide()
            else:
                self.show_window()

    def show_window(self):
        self.show()
        self.setWindowState(self.windowState() & ~Qt.WindowState.WindowMinimized)
        self.raise_()
        self.activateWindow()

    def closeEvent(self, event):
        if self.tray and not self.quitting:
            event.ignore()
            self.hide()
            if not self.tray_hint_shown:
                self.tray_hint_shown = True
                self.tray.showMessage(APP_NAME, "Still running in the tray. Use Quit to close it.",
                                      QSystemTrayIcon.MessageIcon.Information, 4000)
            return
        event.accept()

    def quit(self):
        if self.display_state() != "disconnected":
            answer = QMessageBox.question(
                self, APP_NAME, "The VPN stays connected after closing the application. Quit anyway?")
            if answer != QMessageBox.StandardButton.Yes:
                return
        self.quitting = True
        QApplication.instance().quit()


def main():
    if QApplication is None:
        print("fortivpn-manager requires PyQt6 (package python3-pyqt6).", file=sys.stderr)
        return 1
    app = QApplication(sys.argv)
    app.setApplicationName(APP_NAME)
    app.setDesktopFileName("fortivpn-manager")
    app.setQuitOnLastWindowClosed(False)

    # Single instance per user: a second launch brings the window forward.
    server_name = f"{APP_NAME}-{os.getuid()}"
    probe = QLocalSocket()
    probe.connectToServer(server_name)
    if probe.waitForConnected(300):
        probe.write(b"show")
        probe.waitForBytesWritten(300)
        return 0
    QLocalServer.removeServer(server_name)
    server = QLocalServer()
    server.listen(server_name)

    window = MainWindow()
    server.newConnection.connect(lambda: (server.nextPendingConnection(), window.show_window()))
    window.show()
    if not window.tray:
        app.setQuitOnLastWindowClosed(True)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
