+/**
+ * Case-insensitive substring search inside a (non null-terminated) chunk.
+ */
+static bool prompt_contains(chunk_t hay, const char *needle)
+{
+	size_t nlen = strlen(needle), i, j;
+
+	if (!nlen || hay.len < nlen)
+	{
+		return FALSE;
+	}
+	for (i = 0; i + nlen <= hay.len; i++)
+	{
+		for (j = 0; j < nlen; j++)
+		{
+			char a = hay.ptr[i + j], b = needle[j];
+
+			if (a >= 'A' && a <= 'Z') { a += 32; }
+			if (b >= 'A' && b <= 'Z') { b += 32; }
+			if (a != b)
+			{
+				break;
+			}
+		}
+		if (j == nlen)
+		{
+			return TRUE;
+		}
+	}
+	return FALSE;
+}
+
+/**
+ * Run an external helper command and capture its first line of stdout as the
+ * second-factor value (e.g. an e-mail/SMS OTP). The helper is expected to
+ * block until the code is available (for instance by reading a FIFO fed by a
+ * mailbox poller) and to enforce its own timeout. On success, 'out' holds an
+ * allocated chunk the caller must clear with chunk_clear().
+ */
+static bool run_otp_helper(char *cmd, chunk_t *out)
+{
+	FILE *pipe;
+	char buf[256];
+	size_t len;
+
+	DBG1(DBG_IKE, "EAP-GTC: invoking OTP helper for second-factor challenge");
+	pipe = popen(cmd, "r");
+	if (!pipe)
+	{
+		DBG1(DBG_IKE, "EAP-GTC: failed to run OTP helper '%s'", cmd);
+		return FALSE;
+	}
+	if (!fgets(buf, sizeof(buf), pipe))
+	{
+		DBG1(DBG_IKE, "EAP-GTC: OTP helper returned no data");
+		pclose(pipe);
+		return FALSE;
+	}
+	pclose(pipe);
+
+	/* strip trailing CR/LF and surrounding whitespace */
+	len = strlen(buf);
+	while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r' ||
+					   buf[len - 1] == ' '  || buf[len - 1] == '\t'))
+	{
+		buf[--len] = '\0';
+	}
+	if (!len)
+	{
+		DBG1(DBG_IKE, "EAP-GTC: OTP helper returned an empty code");
+		memwipe(buf, sizeof(buf));
+		return FALSE;
+	}
+	*out = chunk_clone(chunk_create(buf, len));
+	memwipe(buf, sizeof(buf));
+	return TRUE;
+}
